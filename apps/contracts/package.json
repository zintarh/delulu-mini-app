{
  "name": "hardhat",
  "version": "1.0.0",
  "description": "Smart contracts for delulu-v0",
  "main": "index.js",
  "scripts": {
    "build": "HARDHAT_TELEMETRY_DISABLED=1 hardhat compile --config hardhat.config.cjs",
    "compile": "HARDHAT_TELEMETRY_DISABLED=1 hardhat compile --config hardhat.config.cjs",
    "test": "HARDHAT_TELEMETRY_DISABLED=1 hardhat test test/Delulu.js --config hardhat.config.cjs",
    "validate:upgrade": "HARDHAT_TELEMETRY_DISABLED=1 hardhat run scripts/validate-upgrade.cjs --config hardhat.config.cjs",
    "upgrade:celo": "HARDHAT_TELEMETRY_DISABLED=1 hardhat run scripts/upgrade-delulu-v3.cjs --config hardhat.config.cjs --network celo",
    "upgrade:sepolia": "HARDHAT_TELEMETRY_DISABLED=1 hardhat run scripts/upgrade-delulu-v3.cjs --config hardhat.config.cjs --network sepolia",
    "simulate:upgrade": "HARDHAT_TELEMETRY_DISABLED=1 hardhat run scripts/simulate-uups-upgrade-hardhat.cjs --config hardhat.config.cjs --network hardhat",
    "verify": "hardhat verify",
    "clean": "HARDHAT_TELEMETRY_DISABLED=1 hardhat clean --config hardhat.config.cjs"
  },
  "keywords": [
    "hardhat",
    "ethereum",
    "celo",
    "smart-contracts",
    "solidity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "chai": "^4.2.0",
    "ethers": "^6.4.0",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.1",
    "ts-node": ">=8.0.0",
    "typescript": ">=4.5.0",
    "viem": "^2.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.0"
  }
}
